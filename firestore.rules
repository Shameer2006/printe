rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Vendors: Publicly readable so store pages can display pricing and info
    match /vendors/{vendorSlug} {
      allow read: if true;
      allow write: if false;
    }

    // Orders:
    // - Read allowed for checking order status & displaying receipt
    // - Create allowed only if initial payment_status is 'PENDING'
    // - Update/Delete blocked from client (status updates strictly managed by server Admin SDK)
    match /orders/{orderCode} {
      allow read: if true;
      allow create: if request.resource.data.payment_status == 'PENDING';
      allow update, delete: if false;
    }

    // Default deny for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

